# Postgres connection the running API uses. Must be a NON-superuser role
# (docker-compose.yml + db/init-db.sql create `custodian_app` for this) or
# the RLS policies in prisma/rls.sql are silently bypassed — Postgres
# superusers ignore RLS unconditionally, no exceptions.
DATABASE_URL="postgresql://custodian_app:custodian_dev_password@localhost:5432/custodian?schema=public"

# Used only for `npm run prisma:migrate` / `prisma:deploy` — the bootstrap
# superuser, which needs schema-altering privileges the app role doesn't
# have. Export this in place of DATABASE_URL just for the migrate command,
# e.g.: DATABASE_URL="$MIGRATE_DATABASE_URL" npx prisma migrate dev
MIGRATE_DATABASE_URL="postgresql://custodian_admin:custodian_admin_dev_password@localhost:5432/custodian?schema=public"

REDIS_URL="redis://localhost:6379"

# Row-Level Security: the database-enforced second layer of tenant isolation.
# Turn this on ONLY after running `psql "$DATABASE_URL" -f prisma/rls.sql`,
# and make sure DATABASE_URL points at the non-superuser app role — Postgres
# superusers ignore RLS entirely, so it would appear enabled while doing
# nothing. Leave false and you still have the application-layer filters.
ENABLE_RLS="false"

PORT=3000

# Generate real random secrets before anything but local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="dev-only-change-me-access"
JWT_REFRESH_SECRET="dev-only-change-me-refresh"

# Encrypts secrets that admins enter through the UI (WhatsApp access tokens,
# app secrets). Without it, the WhatsApp setup screen refuses to store
# credentials. Keep it OUT of the database and back it up — losing it means
# re-entering every WhatsApp token.
APP_ENCRYPTION_KEY="dev-only-change-me-encryption-key"

# Public HTTPS base URL of this API. Shown on the WhatsApp setup screen as the
# webhook URL to paste into Meta. On a laptop use an ngrok URL.
PUBLIC_API_URL="http://localhost:3010"

# --- Calling (WebRTC) -------------------------------------------------------
# Public STUN is used by default and is enough when both people can reach each
# other fairly directly (same office LAN, home networks with friendly NATs).
#
# Calls that cross symmetric NATs or strict corporate firewalls need a TURN
# *relay* server, which you have to run or rent — there is no free public TURN
# worth relying on. Without it, expect some calls to ring, connect signalling,
# and then fail to establish media. Set all three to enable:
# TURN_URL="turn:turn.example.com:3478"
# TURN_USERNAME=""
# TURN_CREDENTIAL=""

# --- WhatsApp Business Platform (Cloud API) ---------------------------------
# Leave WHATSAPP_PROVIDER unset (or "mock") until a real WhatsApp Business
# Account exists — MockWhatsappProvider logs sends instead of calling Meta.
WHATSAPP_PROVIDER=mock

# Required once WHATSAPP_PROVIDER=meta. Set by you in Meta's App Dashboard
# when you subscribe the webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Required once WHATSAPP_PROVIDER=meta. Verifies X-Hub-Signature-256 on
# inbound webhooks — without it, webhook signature checks are skipped
# (fine for local dev against the mock provider, never in production).
WHATSAPP_APP_SECRET=""

# Per-phone-number access token, referenced by WhatsappAccount.accessTokenRef
# as "WHATSAPP_TOKEN__<phoneNumberId>". This env-var lookup is a local-dev
# stand-in — replace with a real secrets manager (see meta-whatsapp.provider.ts)
# before handling a live access token.
# WHATSAPP_TOKEN__<your-phone-number-id>="EAAG..."
